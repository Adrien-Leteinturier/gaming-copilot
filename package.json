{
  "name": "gaming-copilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-seo.mjs && vite --host 127.0.0.1",
    "build": "node scripts/generate-seo.mjs --production && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "dev:full": "vercel dev",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/*.ts\" \"api/*.ts\" \"tooling/*.ts\" \"tests/*.ts\" vite.config.ts",
    "seo:generate": "node scripts/generate-seo.mjs --production"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "cheerio": "^1.2.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vercel": "^48.0.0",
    "vite": "^7.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
